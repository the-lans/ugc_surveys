# Настройки Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=your-server-ip-or-domain
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECURE_SSL_REDIRECT=False

# База данных
DB_PASSWORD=your-postgres-password
DATABASE_URL=postgres://django:your-postgres-password@db:5432/ugc_surveys
# Время жизни постоянного соединения к БД в секундах (0 — не переиспользовать)
DB_CONN_MAX_AGE=60

# Gunicorn (опционально, есть дефолты)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Для локальной разработки DATABASE_URL не нужен —
# используется SQLite из config/settings/dev.py
