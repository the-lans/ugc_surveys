# Настройки Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECURE_SSL_REDIRECT=False

# База данных (для прода)
DATABASE_URL=postgres://user:password@db:5432/ugc_surveys
# Время жизни постоянного соединения к БД в секундах (0 — не переиспользовать)
DB_CONN_MAX_AGE=60

# Gunicorn (опционально, есть дефолты)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Для локальной разработки DATABASE_URL не нужен —
# используется SQLite из config/settings/dev.py
